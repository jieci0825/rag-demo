{
    "name": "rag-demo-server",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "pnpm db:migrate && pnpm dev:server",
        "dev:server": "tsx src/server.ts",
        "build": "tsc -p tsconfig.json",
        "test": "vitest run",
        "start": "NODE_ENV=production node dist/server.js",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate"
    },
    "dependencies": {
        "@koa/cors": "^5.0.0",
        "@koa/multer": "4.0.0",
        "@koa/router": "latest",
        "dotenv": "latest",
        "drizzle-orm": "latest",
        "koa": "latest",
        "koa-bodyparser": "latest",
        "marked": "18.0.5",
        "multer": "2.1.1",
        "pg": "latest",
        "pino": "^10.3.1",
        "zod": "latest"
    },
    "devDependencies": {
        "@types/koa": "latest",
        "@types/koa-bodyparser": "latest",
        "@types/koa__cors": "^5.0.1",
        "@types/koa__multer": "2.0.8",
        "@types/koa__router": "latest",
        "@types/multer": "2.0.0",
        "@types/node": "latest",
        "@types/pg": "latest",
        "drizzle-kit": "latest",
        "pino-pretty": "^13.1.3",
        "tsx": "latest",
        "typescript": "latest",
        "vitest": "^4.1.8"
    }
}
